MEET_DOMAIN=meet.intra.example.com
LIVEKIT_DOMAIN=rtc.intra.example.com
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_NODE_IP=10.20.0.10

MEET_INITIAL_ADMIN_USER=admin
MEET_INITIAL_ADMIN_PASSWORD=change-this-admin-password
LIVEKIT_API_KEY=change-this-livekit-key
LIVEKIT_API_SECRET=change-this-livekit-secret-at-least-32-characters
