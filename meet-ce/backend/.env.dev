# 开发模式默认 6081：本机与商业版（6080）同时运行时端口不冲突
SERVER_PORT=6081

USE_HTTPS=false
MEET_LOG_LEVEL=debug
SERVER_CORS_ORIGIN=*
MEET_INITIAL_API_KEY=meet-api-key

# 默认对齐商业版开发底座（.runtime/docker-compose.dev.yml 共用的 Mongo/Redis/LiveKit）。
# 独立搭建底座时按需调整：Mongo 默认 localhost:27017、LiveKit 默认 ws://localhost:7880（devkey/secret）。
# Mongo 库名与商业版（jmeet）隔离，避免迁移与数据互相污染。
MEET_MONGO_DB_NAME=jmeet-oss-dev
MEET_REDIS_PORT=6381
MEET_REDIS_PASSWORD=redispassword
