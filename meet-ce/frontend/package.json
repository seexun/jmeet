{
	"name": "@openvidu-meet/frontend",
	"version": "1.0.0",
	"scripts": {
		"clean": "rm -rf node_modules dist test-results .angular",
		"assets:livekit": "node scripts/copy-livekit-assets.mjs",
		"postinstall": "node scripts/copy-livekit-assets.mjs",
		"dev": "pnpm run assets:livekit && pnpm exec ng build --configuration development --watch",
		"build": "pnpm run assets:livekit && node -e \"const { spawnSync } = require('node:child_process'); const baseHref = process.argv[1] || '/'; const result = spawnSync(process.execPath, ['node_modules/@angular/cli/bin/ng.js', 'build', '--configuration', 'production', '--base-href', baseHref], { stdio: 'inherit' }); process.exit(result.status ?? 1);\"",
		"lib:serve": "ng build shared-meet-components --watch",
		"lib:build": "ng build shared-meet-components --configuration production",
		"lib:pack": "cd dist/shared-meet-components && pnpm pack",
		"test:unit": "ng test openvidu-meet --watch=false --code-coverage",
		"test:unit:lib": "ng test shared-meet-components --watch=false --browsers=ChromeHeadlessCI",
		"e2e:playwright": "playwright test --project=spa",
		"lint:fix": "eslint src --fix",
		"lint:design-system": "node scripts/check-design-system.mjs",
		"lint:design-system:strict": "node scripts/check-design-system.mjs --strict",
		"lint:styles": "stylelint \"projects/shared-meet-components/styles/**/*.scss\"",
		"format:code": "prettier --ignore-path ../gitignore . --write"
	},
	"dependencies": {
		"@angular/animations": "21.2.17",
		"@angular/cdk": "21.2.14",
		"@angular/common": "21.2.17",
		"@angular/compiler": "21.2.17",
		"@angular/core": "21.2.17",
		"@angular/forms": "21.2.17",
		"@angular/platform-browser": "21.2.17",
		"@angular/platform-browser-dynamic": "21.2.17",
		"@angular/router": "21.2.17",
		"@ant-design/icons-angular": "^22.1.1",
		"@livekit/track-processors": "0.7.2",
		"@mediapipe/tasks-vision": "0.10.14",
		"@openvidu-meet/shared-components": "workspace:*",
		"@openvidu-meet/typings": "workspace:*",
		"core-js": "3.47.0",
		"deepfilternet3-noise-filter": "1.3.0",
		"jwt-decode": "4.0.0",
		"linkify-string": "4.3.3",
		"linkifyjs": "4.3.3",
		"livekit-client": "2.16.1",
		"ng-zorro-antd": "21.3.3",
		"rxjs": "7.8.2",
		"tslib": "2.8.1",
		"zone.js": "0.15.1"
	},
	"devDependencies": {
		"@angular-builders/custom-webpack": "21.0.3",
		"@angular-devkit/build-angular": "21.2.16",
		"@angular-eslint/builder": "21.2.0",
		"@angular-eslint/eslint-plugin": "21.2.0",
		"@angular-eslint/eslint-plugin-template": "21.2.0",
		"@angular-eslint/schematics": "21.2.0",
		"@angular-eslint/template-parser": "21.2.0",
		"@angular/cli": "21.2.16",
		"@angular/compiler-cli": "21.2.17",
		"@playwright/test": "1.60.0",
		"@types/chai": "4.3.20",
		"@types/fluent-ffmpeg": "2.1.28",
		"@types/jasmine": "5.1.15",
		"@types/mocha": "9.1.1",
		"@types/node": "22.18.13",
		"@types/pixelmatch": "5.2.6",
		"@types/pngjs": "6.0.5",
		"@typescript-eslint/eslint-plugin": "8.46.4",
		"@typescript-eslint/parser": "8.46.4",
		"chai": "4.5.0",
		"cross-env": "7.0.3",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.2",
		"fluent-ffmpeg": "2.1.3",
		"jasmine": "5.13.0",
		"jasmine-core": "5.6.0",
		"jasmine-spec-reporter": "7.0.0",
		"karma": "6.4.4",
		"karma-chrome-launcher": "3.2.0",
		"karma-coverage": "2.2.1",
		"karma-jasmine": "5.1.0",
		"karma-jasmine-html-reporter": "2.1.0",
		"mocha": "10.7.3",
		"ng-packagr": "21.2.5",
		"prettier": "3.3.3",
		"stylelint": "^17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"ts-node": "10.9.2",
		"tslib": "2.6.3",
		"typescript": "5.9.3"
	}
}
